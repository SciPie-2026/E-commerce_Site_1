# Server & Database
NODE_ENV=development
PORT=8080
DATABASE_URL="file:./dev.db" # or postgresql://user:password@localhost:5432/aidah_db

# Security & Secrets
JWT_SECRET="aidah_jwt_secret_production_ready_high_entropy_key_2026_random_secure_hex"
REFRESH_TOKEN_SECRET="aidah_refresh_secret_production_ready_high_entropy_key_2026_random_secure_hex"
COOKIE_SECRET="aidah_cookie_signing_secret_32_characters_len"

# Admin Initial Seed
DEFAULT_ADMIN_EMAIL="admin@aidah.com"
DEFAULT_ADMIN_PASSWORD="ChangeMeInProduction#2026!"

# Payment Gateway (Razorpay)
# Set to "MOCK" to use Mock Payment Gateway in development, or "RAZORPAY" in live/test mode
PAYMENT_GATEWAY_PROVIDER="MOCK"
RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID_HERE"
RAZORPAY_KEY_SECRET="YOUR_KEY_SECRET_HERE"
RAZORPAY_WEBHOOK_SECRET="YOUR_WEBHOOK_SECRET_HERE"
